# Bu dosyayı .env olarak kopyalayıp değerleri düzenleyin. Tüm ayarlar: app/core/config.py

# Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# İlk çalıştırmada oluşturulacak admin hesabı
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!

DATABASE_URL=sqlite:///./data/studyspot.db
TIMEZONE=Europe/Istanbul

# Rezervasyon kuralları
MAX_RESERVATION_HOURS=3
DAILY_LIMIT_HOURS=4
WEEKLY_LIMIT_HOURS=12
MAX_ADVANCE_DAYS=14

# Check-in ve ceza
CHECKIN_OPEN_MINUTES_BEFORE=10
CHECKIN_GRACE_MINUTES=15
NO_SHOW_PENALTY_POINTS=2
LATE_CANCEL_MINUTES=30
LATE_CANCEL_PENALTY_POINTS=1
PENALTY_BAN_THRESHOLD=6
BAN_DAYS=7

# Arka plan görevleri
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
REMINDER_MINUTES_BEFORE=30

# Harici API: resmi tatiller (date.nager.at)
HOLIDAY_CHECK_ENABLED=true
HOLIDAY_COUNTRY=TR

# E-posta: "console" yalnızca loglar ve EmailLog tablosuna yazar; "smtp" gerçekten gönderir
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=StudySpot <no-reply@example.com>
